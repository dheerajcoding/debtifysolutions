# ---------- Core ----------
# development | production
NODE_ENV=development
PORT=5000
# Public URL of the site (used in email links)
APP_URL=http://localhost:5173
# Allowed browser origins (comma separated). In production, your domain, e.g. https://debtify.com
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Local MongoDB or Atlas. Leave empty in development to use the in-memory store.
# REQUIRED in production.
MONGO_URI=mongodb://127.0.0.1:27017/debtify

# ---------- Security (REQUIRED in production) ----------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
# How long a login lasts
SESSION_DAYS=7
# Set when running behind a proxy / load balancer (Render, Railway, Nginx): number of hops
TRUST_PROXY=

# ---------- First admin (staff console login) ----------
# Created automatically on first start if the email doesn't exist yet.
ADMIN_EMAIL=admin@debtify.local
ADMIN_PASSWORD=ChangeMe2026

# ---------- Email (verification + password reset) ----------
# Leave SMTP_HOST empty in development: emails appear at http://localhost:5173/dev/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Debtify <no-reply@yourdomain.com>

# ---------- Features ----------
# Test personas + simulated partner events in the staff console (defaults: on in dev, off in prod)
DEMO_MODE=true
# Seed 181 sample applications into the admin dashboard (defaults: on in dev, off in prod)
SEED_SAMPLES=true

# Optional: Jay answers with Claude (guard-railed to approved facts). Otherwise the approved FAQ.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Text messages (phone codes + TCPA opt-out) ----------
# Leave empty in development: codes are shown on screen and in /dev/outbox.
# Point your Twilio number's inbound webhook at  https://YOUR_DOMAIN/api/webhooks/sms  (STOP handling).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Compliance ----------
# sha256 of the published partner list (/legal/disclosures#partners). Bump whenever the list changes.
PARTNER_LIST_HASH=

# ---------- Launch settings ----------
# Never show phone codes on screen in production. Set to "true" ONLY for a private test with no SMS provider.
SHOW_OTP_ON_SCREEN=
# Optional analytics. Loaded only after a visitor accepts cookies. Leave empty to disable.
GA_MEASUREMENT_ID=
META_PIXEL_ID=
